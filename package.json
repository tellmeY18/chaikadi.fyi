{
  "name": "chaikadi.fyi",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": "github:tellmeY18/chaikadi.fyi",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node -e \"require('fs').rmSync('coverage',{recursive:true,force:true})\" && node --test --test-concurrency=4 tests/e2e/*.e2e.mjs && node tests/e2e/coverage.mjs",
    "test:all": "npm test && npm run test:e2e",
    "brand": "node tools/sync-brand.mjs",
    "brand:check": "node tools/sync-brand.mjs --check"
  }
}
